{
  "name": "externalize",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:exercises": "tsx tools/exercise-generator/cli.ts",
    "inventory": "tsx scripts/generate-inventory.ts",
    "inventory:update": "tsx scripts/generate-inventory.ts --write",
    "inventory:check": "tsx scripts/generate-inventory.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "release:check": "npm run inventory:check && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "@types/node": "^24.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.52.0"
  },
  "engines": {
    "node": "22.x"
  }
}
