{
  "name": "externalize",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && npm run d1:migrate:local && wrangler pages dev dist --ip 0.0.0.0 --port 8788",
    "d1:migrate:local": "wrangler d1 migrations apply externalize-progress --local",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:exercises": "tsx tools/exercise-generator/cli.ts",
    "inventory": "tsx scripts/generate-inventory.ts",
    "inventory:update": "tsx scripts/generate-inventory.ts --write",
    "inventory:check": "tsx scripts/generate-inventory.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "release:check": "npm run inventory:check && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3"
  }
}
